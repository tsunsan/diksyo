# ==============================================================================
# Diksyo (.env.example)
# Copy this file to .env.local and update with your own configuration and credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL via Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: Used by the Next.js app / Drizzle ORM client at runtime.
# Use Supabase's Transaction Pooler (port 6543) for serverless resilience.
# Recommended parameters: prepare=false, connection_limit=5, connect_timeout=10
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-password]@[your-pooler-host]:6543/postgres?prepare=false&connection_limit=5&connect_timeout=10"

# DIRECT_URL: Direct database connection (port 5432) used by Drizzle Kit for schema migrations.
DIRECT_URL="postgresql://postgres.[your-project-ref]:[your-password]@[your-direct-host]:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Supabase Auth & Client Keys
# ------------------------------------------------------------------------------
# Found in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[your-project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 3. Application URL & Canonical Domain
# ------------------------------------------------------------------------------
# Used for OpenGraph image generation, OAuth redirects, and canonical metadata.
# Local Development: http://localhost:3000
# Production: https://diksyo.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Upstash Redis (Rate Limiting & Edge Tool Caching)
# ------------------------------------------------------------------------------
# Create a free Redis database at https://console.upstash.com
# Used for bot protection, mutation rate limiting, and zero-latency AI dictionary lookups.
UPSTASH_REDIS_REST_URL="https://[your-redis-instance].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ------------------------------------------------------------------------------
# 5. AI Features (Google Generative AI SDK)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Powers Diksyo AI (Gemini 3.5 Flash Lite, Gemini 3.1 Flash Lite, Gemma 4 31B failover)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"

# ------------------------------------------------------------------------------
# 6. Optional Development / Diagnostics Flags
# ------------------------------------------------------------------------------
# Set to 'true' to run Next.js Bundle Analyzer during `npm run build`
# ANALYZE="true"
